NODE_ENV=development
# Copy to .env and replace the password placeholder before starting Compose.
POSTGRES_PASSWORD=replace-with-a-random-password
# Shared player vision radius in hexagonal cells (1-12).
PLAYER_VISION_RADIUS_CELLS=3
GAME_PORT=8080
# Admin is local to the notebook by default.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8081
