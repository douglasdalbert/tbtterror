NODE_ENV=production
# Required: set a random password in .env; this value is intentionally empty.
POSTGRES_PASSWORD=
# Shared player vision radius in hexagonal cells (1-12).
PLAYER_VISION_RADIUS_CELLS=2
# One turn lasts one second by default; valid range is 100-60000 milliseconds.
TURN_DURATION_MS=1000
# Base movement speed in hexagonal cells per turn (must be positive).
BASE_MOVEMENT_CELLS_PER_TURN=1
# Game server config.
GAME_PORT=8080
# Admin server config.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8081
