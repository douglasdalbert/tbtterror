NODE_ENV=production
# Required: set a random password in .env; this value is intentionally empty.
POSTGRES_PASSWORD=
# Shared player vision radius in hexagonal cells (1-12).
PLAYER_VISION_RADIUS_CELLS=2
# Base movement speed in hexagonal cells per second (must be positive).
BASE_MOVEMENT_CELLS_PER_SECOND=1
GAME_PORT=8080
# Admin is local to the notebook by default.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8081
